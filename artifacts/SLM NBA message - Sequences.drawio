        <mxCell id="slm-train-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Self-hosted SLM: NBA message (Fine-tuning / LoRA, offline)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="30" as="geometry" />
