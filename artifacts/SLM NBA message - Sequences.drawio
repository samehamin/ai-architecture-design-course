            <Array as="points">
              <mxPoint x="315" y="240" />
              <mxPoint x="315" y="270" />
            </Array>
            <mxPoint x="275" y="240" as="sourcePoint" />
            <mxPoint x="275" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="slm-train-m3" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="3. Read past NBA messages + outcomes (clicked / bought)">
