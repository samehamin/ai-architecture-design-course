          </mxGeometry>
        </mxCell>
        <mxCell id="slm-train-loop" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fillColor=none;" value="loop" vertex="1">
          <mxGeometry height="480" width="760" x="65" y="170" as="geometry" />
