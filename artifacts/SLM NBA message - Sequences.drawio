        <mxCell id="slm-train-loopg" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=11;" value="[weekly schedule]" vertex="1">
          <mxGeometry height="24" width="260" x="121" y="170" as="geometry" />
        </mxCell>
        <mxCell id="slm-train-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=11;" value="Only the small adapter trains (tens of MB); the Qwen 14B base stays frozen. Same training factory as Option 1: pod per run, scale to zero." vertex="1">
