        <mxCell id="slm-train-m8" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;align=left;spacingLeft=4;" value="8. Evaluate vs current adapter (held-out set)">
