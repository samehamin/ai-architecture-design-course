        <mxCell id="slm-train-m1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="1. Create fine-tune Job (LoRA, 1 GPU)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="215" as="sourcePoint" />
            <mxPoint x="275" y="215" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="slm-train-m2" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;align=left;spacingLeft=4;" value="2. Scale GPU pool 0 → 1, start pod">
