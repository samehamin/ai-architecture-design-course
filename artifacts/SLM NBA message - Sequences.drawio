        </mxCell>
        <mxCell id="slm-train-m9" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="9. Register adapter vN (only if better)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="275" y="540" as="sourcePoint" />
            <mxPoint x="615" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="slm-train-m10" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;align=left;spacingLeft=4;" value="10. Delete pod, scale GPU pool to 0">
