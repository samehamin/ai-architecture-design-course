        </mxCell>
        <mxCell id="slm-train-m11" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="11. Load adapter vN (hot-load, no restart)">
