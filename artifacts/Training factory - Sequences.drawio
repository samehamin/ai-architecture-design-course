          <mxGeometry height="785" width="130" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-gke" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;" value="Training cluster (GKE)" vertex="1">
