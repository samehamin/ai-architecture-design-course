        </mxCell>
        <mxCell id="tf-opt2-tt" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;" value="Two-tower retrieval + Ranking model" vertex="1">
          <mxGeometry height="785" width="130" x="380" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-cdp" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;" value="Customer interactions and profiles (CDP)" vertex="1">
          <mxGeometry height="785" width="130" x="550" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-feast" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;" value="Feature Store (Feast)" vertex="1">
          <mxGeometry height="785" width="130" x="720" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-ml" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;" value="Model registry (MLflow)" vertex="1">
          <mxGeometry height="785" width="130" x="890" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-qd" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;" value="Vector DB (Qdrant)" vertex="1">
          <mxGeometry height="785" width="130" x="1060" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Training factory — Option 2: Shared training pod (always on)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-m1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;align=left;spacingLeft=4;" value="0. Shared pod always running (GPU node reserved 24/7)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="315" y="170" />
              <mxPoint x="315" y="200" />
            </Array>
            <mxPoint x="275" y="170" as="sourcePoint" />
            <mxPoint x="275" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m2" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="1. Submit training job to shared pod">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="275" as="sourcePoint" />
            <mxPoint x="275" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-alt" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fillColor=none;" value="alt" vertex="1">
          <mxGeometry height="70" width="250" x="235" y="305" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-altg" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=11;" value="[pod busy with another job]" vertex="1">
          <mxGeometry height="24" width="260" x="291" y="305" as="geometry" />
        </mxCell>
        <mxCell id="tf-opt2-m3" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;align=left;spacingLeft=4;" value="2. Queue job until pod is free">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="315" y="340" />
              <mxPoint x="315" y="370" />
            </Array>
            <mxPoint x="275" y="340" as="sourcePoint" />
            <mxPoint x="275" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m4" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="3. Run training in shared pod">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="275" y="395" as="sourcePoint" />
            <mxPoint x="445" y="395" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m5" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="4. Read interactions">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="435" as="sourcePoint" />
            <mxPoint x="615" y="435" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m6" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=11;" value="5. Interactions">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="475" as="sourcePoint" />
            <mxPoint x="445" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m7" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="6. Read user features (RFM / CLV)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="515" as="sourcePoint" />
            <mxPoint x="785" y="515" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m8" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=11;" value="7. User features">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="785" y="555" as="sourcePoint" />
            <mxPoint x="445" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m9" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;align=left;spacingLeft=4;" value="8. Train new version (GPU)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="485" y="580" />
              <mxPoint x="485" y="610" />
            </Array>
            <mxPoint x="445" y="580" as="sourcePoint" />
            <mxPoint x="445" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tf-opt2-m10" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="9. Register model version">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="635" as="sourcePoint" />
