        </mxCell>
        <mxCell id="pp2-train-m1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;rounded=0;fontSize=11;" value="1. Sink: carts, orders, logins, feedback (continuous)">
