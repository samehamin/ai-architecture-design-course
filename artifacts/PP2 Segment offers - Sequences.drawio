        <mxCell id="pp2-train-m9" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" value="9. Write top items per segment (online)">
          <mxGeometry relative="1" as="geometry">
