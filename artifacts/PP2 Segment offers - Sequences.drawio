        <mxCell id="pp2-train-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Pain point 2: Personalize home page offers per segment (Training / offline batch)&lt;/b&gt;" vertex="1">
