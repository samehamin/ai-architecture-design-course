            <mxPoint x="275" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pp2-train-loop" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fillColor=none;" value="loop" vertex="1">
