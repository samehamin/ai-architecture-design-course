        <mxCell id="pp2-train-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=11;" value="Segments are also used by Campaigns for targeting (Context viewpoint: Segments → Campaigns)." vertex="1">
