        </mxCell>
        <mxCell id="pp2-train-m5" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;align=left;spacingLeft=4;" value="5. RFM scores (past behavior) → CLV (predicted value)&lt;br&gt;→ cluster customers into segments">
